{
	"name": "shopping-list",
	"version": "1.15.1",
	"private": true,
	"type": "module",
	"scripts": {
		"predev": "lsof -ti:44100 | xargs kill -9 2>/dev/null; true",
		"dev": "NODE_ENV=development node --watch --import remix/node-tsx server.ts",
		"start": "NODE_ENV=production node --import remix/node-tsx server.ts",
		"test": "pnpm test:unit && pnpm test:e2e && pnpm test:quality",
		"test:unit": "node --import remix/node-tsx --test app/utils/*.test.ts",
		"test:e2e": "playwright test",
		"test:quality": "node --import remix/node-tsx scripts/lighthouse.ts",
		"typecheck": "tsc --noEmit",
		"format": "biome format --write .",
		"lint": "biome lint --write .",
		"check": "biome check --write . && pnpm i18n:check",
		"i18n:sync": "node --import remix/node-tsx scripts/i18n-sync.ts",
		"i18n:check": "node --import remix/node-tsx scripts/i18n-sync.ts --check",
		"release:patch": "pnpm version patch && git push && git push --tags",
		"release:minor": "pnpm version minor && git push && git push --tags",
		"release:major": "pnpm version major && git push && git push --tags"
	},
	"packageManager": "pnpm@10.34.9",
	"engines": {
		"node": ">=26"
	},
	"dependencies": {
		"marked": "^18.3.0",
		"remix": "3.3.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.9",
		"@playwright/test": "1.65.1",
		"@types/node": "^26.6.10",
		"lighthouse": "^13.6.0",
		"typescript": "^6.0.3"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		]
	}
}
